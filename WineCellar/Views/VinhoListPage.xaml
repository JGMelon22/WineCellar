<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WineCellar.Views.VinhoListPage"
             xmlns:models="clr-namespace:WineCellar.Models"
             Title="Meus Vinhos">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+" Clicked="OnAdicionarClicked"></ToolbarItem>
    </ContentPage.ToolbarItems>

    <CollectionView
        x:Name="VinhosCollectionView"
        SelectionMode="Single"
        SelectionChanged="OnVinhoSelecionado">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Vinho">
                <Grid Padding="12" ColumnDefinitions="Auto,*">
                    <Label
                        Grid.Column="0"
                        Text="🍷"
                        FontSize="28"
                        VerticalOptions="Center"
                        Margin="0,0,12,0">
                    </Label>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="16" />
                        <Label Text="{Binding Regiao}" FontSize="13" TextColor="Gray" />
                        <Label FontSize="13" TextColor="Gray">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Ano}" />
                                    <Span Text=". Nota " />
                                    <Span Text="{Binding Nota}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>