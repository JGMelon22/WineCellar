<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WineCellar.ViewModels"
             x:Class="WineCellar.Views.VinhoFormPage"
             x:DataType="viewmodels:VinhoFormViewModel"
             Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Nome" FontAttributes="Bold" />
            <Entry Text="{Binding Nome}" Placeholder="Ex: Château Margaux" />

            <Label Text="Foto" FontAttributes="Bold" />
            <Border HeightRequest="180"
                    Padding="0"
                   Style="{StaticResource BorderPlaceholderFoto}">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Image
                    Source="{Binding FotoPreview}"
                    Aspect="AspectFill"
                    IsVisible="{Binding TemFoto}" />
            </Border>
            <Button
                Text="Selecionar Foto"
                Command="{Binding SelecionarFotoCommand}" />

            <Label Text="Descrição" FontAttributes="Bold" />
            <Editor Text="{Binding Descricao}" Placeholder="Ex: Notas sobre o vinho" Height="80" />

            <Label Text="País" FontAttributes="Bold" />
            <Entry Text="{Binding Pais}" Placeholder="Ex: França" />

            <Label Text="Região" FontAttributes="Bold" />
            <Entry Text="{Binding Regiao}" Placeholder="Ex: Bordeaux" />

            <Label Text="Uvas" FontAttributes="Bold" />
            <Entry Text="{Binding Uvas}" Placeholder="Ex: Cabernet Sauvignon, Merlot" />

            <Label Text="Ano (Safra)" FontAttributes="Bold" />
            <Entry Text="{Binding Ano}" Placeholder="Ex: 2015" Keyboard="Numeric" />

            <Label Text="Tipo" FontAttributes="Bold" />
            <Picker Title="Selecione o tipo"
                    ItemsSource="{Binding TiposDisponiveis}"
                    SelectedItem="{Binding TipoSelecionado}" />

            <Label Text="Nota (0 a 10)" FontAttributes="Bold" />
            <Entry Text="{Binding NotaTexto}" Placeholder="Ex: 9.5" Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="8">
                <Label Text="Recomenda decantar?" FontAttributes="Bold" VerticalOptions="Center" />
                <Switch IsToggled="{Binding RecomendaDecantar}" />
            </HorizontalStackLayout>

            <Button
                x:Name="SalvarButton"
                Text="Salvar"
                Command="{Binding SalvarCommand}"
                Margin="0,16,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>