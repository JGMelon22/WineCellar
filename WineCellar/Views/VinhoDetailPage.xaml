<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WineCellar.Views.VinhoDetailPage"
             xmlns:viewmodels="clr-namespace:WineCellar.ViewModels"
             x:DataType="viewmodels:VinhoDetailViewModel"
             Title="Detalhes do Vinho">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Compartilhar" Command="{Binding CompartilharCommand}" />
        <ToolbarItem Text="Editar" Command="{Binding EditarCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Border
                HeightRequest="180"
                BackgroundColor="LightGray"
                Padding="0"
                HorizontalOptions="Fill">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Grid>
                    <Label
                        Text="Sem foto"
                        IsVisible="{Binding SemFoto}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        TextColor="Gray" />
                    <Image
                        Source="{Binding FotoOrigem}"
                        Aspect="AspectFill"
                        IsVisible="{Binding TemFoto}" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="24" />
                <Label Text="{Binding Tipo}" FontSize="16" TextColor="Gray" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="LightGray" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                    <Label Text="País" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding Pais}" FontSize="16" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                    <Label Text="Região" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding Regiao}" FontSize="16" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                    <Label Text="Safra" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding Ano}" FontSize="16" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                    <Label Text="Nota" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding Nota}" FontSize="16" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <Label Text="Uvas" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                    <Label Text="{Binding Uvas}" FontSize="16" />
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" BackgroundColor="LightGray" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Descrição" FontAttributes="Bold" FontSize="12" TextColor="Gray" />
                <Label Text="{Binding Descricao}" FontSize="16" />
            </VerticalStackLayout>

            <Label Text="{Binding DecantarTexto}" FontSize="16" FontAttributes="Italic" />

            <Button
                Text="Excluir vinho"
                BackgroundColor="IndianRed"
                TextColor="White"
                Command="{Binding ExcluirCommand}"
                Margin="0,24,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>